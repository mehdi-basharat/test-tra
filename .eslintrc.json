{
  "extends": ["next", "prettier", "next/core-web-vitals"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "plugins": ["@typescript-eslint", "simple-import-sort", "unused-imports", "no-relative-import-paths"],
  "rules": {
    "object-shorthand": [
      "warn",
      "always",
      {
        "avoidExplicitReturnArrows": false,
        "avoidQuotes": true
      }
    ],
    "no-relative-import-paths/no-relative-import-paths": [
      "error",
      {
        "allowSameFolder": true,
        "allowedDepth": 4
      }
    ],
    "@typescript-eslint/array-type": [
      "warn",
      {
        "default": "array-simple"
      }
    ],
    "@typescript-eslint/consistent-type-imports": [
      "warn",
      {
        "fixStyle": "separate-type-imports"
      }
    ],
    "@typescript-eslint/no-explicit-any": "warn",
    "@typescript-eslint/no-unused-vars": "off",
    "@typescript-eslint/typedef": "warn",
    "no-console": "warn",
    "no-restricted-imports": [
      "warn",
      {
        "paths": [
          {
            "name": "react",
            "importNames": ["default"],
            "message": "Do not import React. It's not necessary with React 17+."
          },
          {
            "name": "@next/third-parties/google",
            "importNames": ["sendGTMEvent"],
            "message": "Please import `sendGTMEvent` from `@/lib/gtm` instead"
          }
        ]
      }
    ],
    "no-unused-vars": "off",
    "react/destructuring-assignment": ["error", "always"],
    "react/display-name": "warn",
    "react/jsx-fragments": "warn",
    "react/jsx-key": [
      "error",
      {
        "checkFragmentShorthand": true,
        "checkKeyMustBeforeSpread": true,
        "warnOnDuplicates": true
      }
    ],
    "react/jsx-max-depth": [
      "warn",
      {
        "max": 10
      }
    ],
    "react/jsx-no-useless-fragment": "error",
    "react/jsx-props-no-multi-spaces": "warn",
    "react/jsx-sort-props": [
      "warn",
      {
        "callbacksLast": true,
        "noSortAlphabetically": false,
        "reservedFirst": true,
        "shorthandLast": true
      }
    ],
    "react/no-array-index-key": "warn",
    "react/no-unstable-nested-components": [
      "error",
      {
        "allowAsProps": true
      }
    ],
    "react/self-closing-comp": "warn",
    "simple-import-sort/exports": "warn",
    "simple-import-sort/imports": [
      "warn",
      {
        "groups": [
          ["^\\u0000"],
          ["^node:"],
          ["^react$", "^next(/.*)?$"],
          ["^next-.*$"],
          ["^@?\\w"],
          ["^@/app"],
          ["^@/assets"],
          ["^@/components"],
          ["^@/constants"],
          ["^@/hooks"],
          ["^@/lib"],
          ["^@/model"],
          ["^@/repository"],
          ["^@/styles"],
          ["^@/types"],
          ["^@/utils"],
          ["^\\.\\.(?!/?$)", "^\\.\\./?$"],
          ["^\\./(?=.*/)(?!/?$)", "^\\.(?!/?$)", "^\\./?$"],
          ["^.+\\.s?css$"]
        ]
      }
    ],
    "unused-imports/no-unused-imports": "warn",
    "unused-imports/no-unused-vars": [
      "warn",
      {
        "args": "after-used",
        "argsIgnorePattern": "^_",
        "vars": "all",
        "varsIgnorePattern": "^_"
      }
    ]
  }
}
